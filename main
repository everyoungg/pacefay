import React, { useState } from 'react';
import './App.css';

function App() {
  const [step, setStep] = useState('checkout'); // checkout -> complete -> facepay_prompt
  const [agreedMarketing, setAgreedMarketing] = useState(false);

  // 일반 결제 완료 핸들러
  const handlePayment = (e) => {
    e.preventDefault();
    setStep('complete');
  };

  return (
    <div className="app-container">
      <header className="app-header">
        <h1>안심 간편결제 서비스</h1>
        <p className="subtitle">소비자 주권과 생체 정보를 보호하는 클린 금융 앱</p>
      </header>

      <main className="main-card">
        {/* Step 1: 일반 결제 화면 (다크패턴 원천 차단: 카메라 구동 없음) */}
        {step === 'checkout' && (
          <form onSubmit={handlePayment} className="form-section">
            <h2>상품 결제하기</h2>
            <div className="product-info">
              <p>상품명: 프리미엄 보안 패키지</p>
              <p className="price">결제 금액: <strong>49,000원</strong></p>
            </div>
            
            <div className="payment-methods">
              <label className="method-label">
                <input type="radio" name="pay" defaultChecked /> 일반 신용/체크카드 결제
              </label>
            </div>

            <button type="submit" className="primary-btn">
              49,000원 안전하게 결제하기
            </button>
          </form>
        )}

        {/* Step 2: 결제 완료 영수증 페이지 (Face-Clean Flow 시작점) */}
        {step === 'complete' && (
          <div className="success-section">
            <div className="success-icon">✓</div>
            <h2>결제가 안전하게 완료되었습니다!</h2>
            <p>주문번호: FP-2026-0608-9921</p>
            
            <div className="receipt-box">
              <p>결제 수단: 신용카드 (일시불)</p>
              <p>승인 일시: 2026년 6월 8일</p>
            </div>

            <button 
              onClick={() => setStep('facepay_prompt')} 
              className="secondary-btn"
            >
              메인으로 돌아가기
            </button>
          </div>
        )}

        {/* Step 3: 독립된 영수증 하단 팝업 (Face-Clean Flow: 기본값 거절 & 100% 분리) */}
        {step === 'facepay_prompt' && (
          <div className="facepay-prompt-box">
            <h3>🔒 페이스페이(안면인식 결제) 도입 안내</h3>
            <p className="desc">
              다음부터 얼굴로 1초 만에 결제하시겠습니까?<br />
              <span className="warning-text">※ 얼굴 데이터는 기기 내부(Secure Enclave)에만 안전하게 보관됩니다.</span>
            </p>

            <div className="consent-box">
              <label>
                <input 
                  type="checkbox" 
                  checked={agreedMarketing} 
                  onChange={(e) => setAgreedMarketing(e.target.checked)} 
                />
                [선택] 맞춤형 쇼핑 혜택 안내를 위한 마케팅 정보 수집 동의
              </label>
            </div>

            <div className="button-group">
              <button 
                onClick={() => alert("페이스페이 등록이 거절되었습니다. 기본 결제 수단이 유지됩니다.")} 
                className="neutral-btn"
              >
                아니오 (거절)
              </button>
              <button 
                onClick={() => alert("페이스페이가 안전하게 등록되었습니다. (언제든지 해지 및 영구 파기 가능)")} 
                className="active-btn"
              >
                예, 등록하기
              </button>
            </div>
          </div>
        )}
      </main>

      <footer className="app-footer">
        <p>🛡️ 본 앱은 3D-Shield Governance 가이드라인을 준수합니다.</p>
      </footer>
    </div>
  );
}

export default App;
