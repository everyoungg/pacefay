body {
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background-color: #f4f6f9;
  color: #333;
}

.app-container {
  max-width: 480px;
  margin: 40px auto;
  padding: 20px;
}

.app-header {
  text-align: center;
  margin-bottom: 24px;
}

.app-header h1 {
  font-size: 24px;
  color: #1a1a1a;
  margin-bottom: 4px;
}

.subtitle {
  font-size: 14px;
  color: #666;
}

.main-card {
  background: #ffffff;
  padding: 24px;
  border-radius: 16px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
}

.form-section h2 {
  font-size: 18px;
  margin-bottom: 16px;
}

.product-info {
  background: #f9fafb;
  padding: 16px;
  border-radius: 8px;
  margin-bottom: 20px;
}

.price {
  font-size: 16px;
  margin-top: 8px;
}

.payment-methods {
  margin-bottom: 24px;
}

.method-label {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 15px;
  cursor: pointer;
}

.primary-btn {
  width: 100%;
  background-color: #2563eb;
  color: white;
  border: none;
  padding: 14px;
  font-size: 16px;
  font-weight: bold;
  border-radius: 8px;
  cursor: pointer;
}

.primary-btn:hover {
  background-color: #1d4ed8;
}

.success-section {
  text-align: center;
  padding: 20px 0;
}

.success-icon {
  width: 50px;
  height: 50px;
  background-color: #22c55e;
  color: white;
  font-size: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  margin: 0 auto 16px auto;
}

.receipt-box {
  background: #f9fafb;
  padding: 12px;
  border-radius: 8px;
  margin: 20px 0;
  text-align: left;
  font-size: 14px;
  color: #4b5563;
}

.secondary-btn {
  background-color: #e5e7eb;
  color: #374151;
  border: none;
  padding: 12px 20px;
  border-radius: 8px;
  font-weight: bold;
  cursor: pointer;
}

.facepay-prompt-box {
  border: 2px solid #e5e7eb;
  padding: 20px;
  border-radius: 12px;
  background-color: #fff;
}

.facepay-prompt-box h3 {
  font-size: 16px;
  margin-bottom: 8px;
}

.desc {
  font-size: 13px;
  color: #4b5563;
  line-height: 1.4;
  margin-bottom: 16px;
}

.warning-text {
  color: #059669;
  font-weight: 500;
}

.consent-box {
  margin-bottom: 20px;
  font-size: 13px;
}

.button-group {
  display: flex;
  gap: 10px;
}

.neutral-btn, .active-btn {
  flex: 1;
  padding: 12px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: bold;
  cursor: pointer;
}

.neutral-btn {
  background-color: #f3f4f6;
  color: #4b5563;
  border: 1px solid #d1d5db;
}

.active-btn {
  background-color: #2563eb;
  color: white;
  border: none;
}

.app-footer {
  text-align: center;
  margin-top: 24px;
  font-size: 12px;
  color: #9ca3af;
}
